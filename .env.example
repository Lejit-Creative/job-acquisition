# Copy to .env.local. Leave blank and the app still runs.
# Never commit .env.local.

# Fit scoring, resume rewrite, hiring-manager pass, positioning polish.
# OpenAI-compatible chat completions.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Used when LLM_API_KEY is empty.
OPENAI_API_KEY=

# Used when neither LLM_API_KEY nor OPENAI_API_KEY is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional connectors.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
# USAJobs requires a contact email as the User-Agent.
USAJOBS_USER_AGENT=

# Read-only Gmail. Create an OAuth client (Desktop or Web) and set the
# redirect to http://localhost:3000/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
